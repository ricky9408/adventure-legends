static void original_arrow(unsigned slot,int x,int y,int col){int j;for(j=0;j<4;j++){if(slot==0||slot==2)rect(x+3-j,y+(slot==0?j:3-j),j*2+1,1,col);else rect(x+(slot==3?j:3-j),y+3-j,1,j*2+1,col);}}
static void original_card(unsigned slot,int x,int y,int w,int chosen){CreatureInstance*c=member(slot);/* Both callers already paint one enclosing UI_BG panel. */rect(x,y,w,1,PAL_GOLD2);rect(x,y+27,w,1,PAL_GOLD2);rect(x,y,1,28,PAL_GOLD2);rect(x+w-1,y,1,28,PAL_GOLD2);if(chosen){rect(x,y,w,2,GOLD);rect(x,y+26,w,2,GOLD);rect(x,y,2,28,GOLD);rect(x+w-2,y,2,28,GOLD);}original_arrow(slot,x+4,y+10,c?TEAL:PAL_SLATE);if(c){const u8*p=companion_form_pixels(c->form_id,0,0);if(p)sprite(p,x+w/2-5,y+5,16,16,0);}else{rect(x+w/2-2,y+13,9,2,PAL_SLATE);}if(slot==adventure_save.roster.selected_party)rect(x+w-5,y+4,2,2,CREAM);}
