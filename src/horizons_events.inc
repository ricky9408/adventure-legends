COLD int horizons_game_event_pending(void){return event_count!=0;}
static COLD int bound_event(const WorldIntent*e){const HorizonsRequest*r=&e->request;CreatureInstance*c;if(r->operation!=HORIZONS_REQUEST_TRIAL_COMPLETE&&r->operation!=HORIZONS_REQUEST_REPEAT_RECRUIT)return 1;c=active();return c&&r->slot<160&&c==&adventure_save.roster.instances[r->slot]&&c->instance_id==r->instance_id&&c->form_id==r->form&&progression_command()==r->command&&e->party==party()&&e->selected==adventure_save.roster.selected_party;}
static COLD void present(const HorizonsRequest*r,int result){int good=result==HORIZONS_CHANGED||result==HORIZONS_NOW_READY||result==HORIZONS_REWARDED;
 if(r->operation==HORIZONS_REQUEST_VISIT){if(good||result==HORIZONS_UNCHANGED)transition_ready=1;else transition_area=0;return;}
 if(r->operation==HORIZONS_REQUEST_ANCHOR){if(good||result==HORIZONS_UNCHANGED){checkpoint_spawn=room==62?4:3;adventure_save.campaign.spawn=checkpoint_spawn;game_health_fill();dirty=1;toast(TX_HZ_REST);}return;}
 if(!good){if(result!=HORIZONS_UNCHANGED)toast(result==HORIZONS_FULL?TX_HZ_FULL:result==HORIZONS_SPACE_RESERVED||result==HORIZONS_COVERAGE_LOSS?TX_HZ_RESERVED:result==HORIZONS_ID_EXHAUSTED?TX_HZ_ID_LIMIT:TX_HZ_FIT);return;}
 dirty=1;
 if(r->operation==HORIZONS_REQUEST_QUEST_CLAIM){creatures_credit_event(&adventure_save.roster,308+r->quest-54,160,CREATURE_CREDIT_PERSONAL_QUEST);progression_refresh();toast(r->quest==57?TX_HZ_HUD_DONE:TX_HZ_RECEIVED);}
 else if(r->operation==HORIZONS_REQUEST_TRIAL_COMPLETE){creatures_credit_event(&adventure_save.roster,481+r->family-41,160,CREATURE_CREDIT_FIELD_AID);progression_refresh();cancel_proof();toast(TX_HZ_TRIAL_DONE);}
 else if(r->operation==HORIZONS_REQUEST_INITIAL_RECRUIT||r->operation==HORIZONS_REQUEST_REPEAT_RECRUIT){cancel_proof();progression_refresh();toast(TX_HZ_INVITED);}
 else if(r->operation==HORIZONS_REQUEST_QUEST_PROGRESS){if(r->quest==57&&r->bit==4){performance_ticks=180;game_horizons_performance_start();}if(r->quest==58&&(r->bit==1||r->bit==2)){creatures_credit_event(&adventure_save.roster,r->bit==1?485:486,160,CREATURE_CREDIT_FIELD_AID);toast(TX_HZ_DISCOVERY);}else if(result==HORIZONS_NOW_READY)toast(TX_HZ_READY);}
 changed();
}
COLD unsigned horizons_game_prepare_event(void){unsigned status;int result;WorldIntent e;if(!event_count)return SAVE5_DONE;if(event_scene!=scene||event_attempt!=attempt||!bound_event(&events[event_index])){horizons_game_cancel_event();return SAVE5_FAILED;}e=events[event_index];if(!event_handle){event_handle=horizons_job_begin(&adventure_save,&e.request,event_scene,event_attempt);if(!event_handle){horizons_game_cancel_event();toast(TX_HZ_FIT);return SAVE5_FAILED;}return SAVE5_BUSY;}status=horizons_job_step(event_handle,1024,event_scene,event_attempt);if(status==SAVE5_BUSY)return status;result=horizons_job_result(event_handle);horizons_job_cancel();event_handle=0;if(status==SAVE5_FAILED){horizons_game_cancel_event();toast(TX_HZ_FIT);return status;}event_index++;present(&e.request,result);if(event_index>=event_count){event_count=event_index=0;if(transition_ready==2)transition_ready=1;persist();return SAVE5_DONE;}if(event_scene!=scene||event_attempt!=attempt){horizons_game_cancel_event();return SAVE5_FAILED;}return SAVE5_BUSY;}
