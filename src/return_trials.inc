/* Thirteen distinct authored workspaces. Geometry never disappears or changes
 * to a generic projection. Every walk uses actual collision-tested movement. */
static int participant(void){ReturnTrialProof*t=&return_game_trial;CreatureInstance*c=active();return t->index<13&&t->scene==scene&&t->attempt==attempt&&t->party==party()&&t->selected==adventure_save.roster.selected_party&&t->slot<160&&c==&adventure_save.roster.instances[t->slot]&&c->instance_id==t->instance_id&&c->form_id==t->form&&progression_command()==t->command&&room==trials[t->index].area;}
static int repeat_participant(void){CreatureInstance*c=active();return repeat_active&&c&&repeat_slot<160&&c==&adventure_save.roster.instances[repeat_slot]&&c->instance_id==repeat_id&&c->form_id==repeat_form&&progression_command()==repeat_command&&party()==repeat_party&&adventure_save.roster.selected_party==repeat_selected;}
static COLD int begin_trial(unsigned index){CreatureInstance*c=active();const TrialDef*d;if(index>=13)return 0;d=&trials[index];if(!c||c->form_id!=d->form||room!=d->area||(progression_command()!=d->command[0]&&progression_command()!=d->command[1])){say(TX_RT_TRIAL_PICK,trial_clues[index][0]);return 1;}cancel_proof();ReturnRequest r={0};r.operation=RETURN_REQUEST_TRIAL_STATUS;r.room=room;r.slot=adventure_save.roster.party[adventure_save.roster.selected_party];r.instance_id=c->instance_id;r.family=d->family;r.key=d->key;r.form=d->form;r.command=progression_command();enqueue(r);return 1;}
static COLD void start_trial(const ReturnRequest*r,int replay){CreatureInstance*c=active();unsigned i;if(!c||c->instance_id!=r->instance_id||c->form_id!=r->form||progression_command()!=r->command)return;for(i=0;i<13;i++)if(trials[i].form==r->form&&trials[i].family==r->family&&trials[i].key==r->key)break;if(i==13)return;cancel_proof();ReturnTrialProof*t=&return_game_trial;t->index=i;t->slot=r->slot;t->instance_id=r->instance_id;t->form=r->form;t->family=r->family;t->key=r->key;t->command=r->command;t->scene=scene;t->attempt=attempt;t->party=party();t->selected=adventure_save.roster.selected_party;t->stage=t->setting=t->casts=t->walk=0;t->replay=(unsigned char)replay;changed();say(trial_clues[i][0],trial_clues[i][1]);}
static int trial_solved(void){ReturnTrialProof*t=&return_game_trial;switch(t->index){case 0:return t->stage==2&&t->setting==1;case 1:return t->casts==3&&t->setting==1&&t->walk;case 2:case 3:case 4:case 12:return t->stage==3;case 5:return t->stage==3&&t->setting==1;case 6:return t->casts==3&&t->setting==1;case 7:return t->stage==4;case 8:return t->casts==3&&t->setting==1;case 9:return t->casts==3&&t->setting==2&&t->walk;case 10:return t->stage==2&&t->setting==1;case 11:return t->stage==4;default:return 0;}}
static COLD void trial_finish(void){ReturnTrialProof*t=&return_game_trial;if(!participant()||!trial_solved())return;if(t->replay){cancel_proof();toast(TX_RT_TRIAL_ALREADY);changed();return;}ReturnRequest r={0};r.operation=RETURN_REQUEST_TRIAL_COMPLETE;r.room=room;r.slot=t->slot;r.instance_id=t->instance_id;r.family=t->family;r.key=t->key;r.form=t->form;r.command=t->command;enqueue(r);}
static COLD int trial_manual(void){ReturnTrialProof*t=&return_game_trial;if(!participant()){cancel_proof();toast(TX_RT_SAME);return 1;}if(t->index==7){if(t->stage==1){t->setting=1;t->stage=2;}else{t->stage=t->casts=t->walk=0;t->setting^=1;}}else if(t->index==1){t->setting^=1;t->walk=0;}else if(t->index==9&&t->casts==3&&t->setting==1)t->setting=2;else{t->setting^=1;t->stage=t->casts=t->walk=0;}changed();toast(TX_RT_ADJUSTED);trial_finish();return 1;}
static COLD int trial_cast(unsigned n){ReturnTrialProof*t=&return_game_trial;int ok=0;if(!participant())return 0;
 switch(t->index){
 case 0:case 10:if(t->setting==1&&n==t->stage&&n<2){t->casts|=1u<<n;t->stage++;ok=1;}break;
 case 1:if(n<2){t->casts|=1u<<n;ok=1;}break;
 case 2:case 3:case 4:case 12:if(t->setting==1&&n==0&&t->stage==0){t->stage=1;t->casts=1;ok=1;}else if(n==1&&t->stage==2){t->stage=3;t->casts|=2;ok=1;}break;
 case 5:if(t->setting==1&&n==t->stage&&n<3){t->casts|=1u<<n;t->stage++;ok=1;}break;
 case 6:case 8:if(t->setting==1&&n<2){t->casts|=1u<<n;ok=1;}break;
 case 7:if(n==0&&t->stage==0){t->casts=1;t->stage=1;ok=1;}else if(n==1&&t->stage==3){t->casts|=2;t->stage=4;ok=1;}break;
 case 9:if(t->setting==1&&n<2){t->casts|=1u<<n;ok=1;}break;
 case 11:if(!t->setting&&n==t->stage&&n<2){t->casts|=1u<<n;t->stage++;ok=1;}else if(n==2&&t->stage==3){t->casts|=4;t->stage=4;ok=1;}break;
 }
 if(!ok){t->stage=t->casts=t->walk=0;toast(TX_RT_FIT);changed();return 2;}toast(TX_RT_TRACE);changed();trial_finish();return 1;
}
static COLD void trial_walk(void){ReturnTrialProof*t=&return_game_trial;const TrialDef*d;if(!participant()){cancel_proof();changed();return;}d=&trials[t->index];if(!near(px,py,d->walk[0],d->walk[1],9)||t->walk)return;
 if((t->index==1&&t->casts==3&&t->setting==1)||(t->index==9&&t->casts==3&&t->setting==2))t->walk=1;
 else if((t->index==2||t->index==3||t->index==4||t->index==12)&&t->stage==1){t->walk=1;t->stage=2;}
 else if((t->index==7||t->index==11)&&t->stage==2){t->walk=1;t->stage=3;}
 if(t->walk){toast(TX_RT_TRACE);changed();trial_finish();}}
static COLD int trial_interact(void){const TrialDef*d;if(return_game_trial.index>=13)return 0;d=&trials[return_game_trial.index];if(close(d->manual[0],d->manual[1]))return trial_manual();if(close(d->lectern[0],d->lectern[1])){say(trial_clues[return_game_trial.index][0],trial_clues[return_game_trial.index][1]);return 1;}return 0;}
static COLD int begin_repeat(unsigned source){CreatureInstance*c=active();unsigned command=source==17?102:104,family=source==17?39:40;if(!c||!creatures_form(c->form_id)||creatures_form(c->form_id)->family!=family||progression_command()!=command||!done(source==17?47:49)){say(TX_RT_TRIAL_PICK,TX_RT_REPEAT_CLUE);return 1;}if(repeat_used&(1u<<(source-17))){toast(TX_RT_REPEAT_USED);return 1;}cancel_proof();repeat_active=source;repeat_stage=repeat_setting=0;repeat_id=c->instance_id;repeat_slot=adventure_save.roster.party[adventure_save.roster.selected_party];repeat_form=c->form_id;repeat_command=command;repeat_party=party();repeat_selected=adventure_save.roster.selected_party;changed();say(TX_RT_REPEAT_CLUE,TX_RT_HOME);return 1;}
static COLD int invite_repeat(void){ReturnRequest r={0};if(!repeat_participant()){cancel_proof();toast(TX_RT_SAME);return 1;}if(repeat_stage!=2){say(TX_RT_REPEAT_CLUE,TX_RT_WALK);return 1;}if(invite_confirm!=1){invite_confirm=1;toast(TX_RT_INVITE);return 1;}r.operation=RETURN_REQUEST_REPEAT_RECRUIT;r.room=room;r.source=repeat_active;r.slot=repeat_slot;r.instance_id=repeat_id;r.family=repeat_active==17?39:40;r.form=repeat_form;r.command=repeat_command;enqueue(r);return 1;}
