#ifndef HZ_REG32
#define HZ_REG32(a) (*(volatile unsigned int*)(a))
#endif
#ifndef HZ_COPY_HALFWORDS
#define HZ_COPY_HALFWORDS(source,destination,count) do { \
 HZ_REG32(0x040000D4)=(unsigned long)(source); \
 HZ_REG32(0x040000D8)=(unsigned long)(destination); \
 HZ_REG32(0x040000DC)=0x80000000u|(count); \
} while(0)
#endif
static COLD void stage_panel(int x,int y){
 extern unsigned short *screen;
 const unsigned char *src=stage_panel_pixels;unsigned short *dst;int row;
 x-=camera_x;y-=camera_y;
 if((x&1)||x<18||x>222||y<10||y>151){sprite(src,x-18,y-10,36,19,0);return;}
 dst=screen+(y-10)*120+(x-16)/2;
 /* The top rail begins on an odd pixel; preserve its transparent neighbor. */
 dst[-1]=(dst[-1]&255)|(PAL_WOOD1<<8);
 HZ_COPY_HALFWORDS(src+2,dst,17);
 for(row=1;row<19;row++){
  src+=36;dst+=120;
  HZ_COPY_HALFWORDS(src+2,dst,16);
  dst[16]=(dst[16]&0xff00)|src[34];
 }
}
